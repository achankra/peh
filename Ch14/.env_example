# Chapter 14 settings - fallback for readers not using Bitwarden
# Copy this to .env and edit it:  cp .env_example .env
# SECURITY: .env is gitignored. Never commit a real key.
#
# Load into your shell:  set -a && source .env && set +a
#
# Both settings are optional - without them the scripts run in mock mode.
# If both are set, Anthropic is used; leave ANTHROPIC_API_KEY empty to use Ollama.

# Option A: Anthropic Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Option B: local model via Ollama. Run `ollama pull mistral && ollama serve` first.
OLLAMA_MODEL=mistral
