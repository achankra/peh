# Chapter 8 configuration - copy this to .env and adjust:  cp .env_example .env
# SECURITY: .env is gitignored. Never commit a real token.
#
# Load into your shell:  set -a && source .env && set +a

# GitHub Personal Access Token for scripts/ci_metrics.py (needs repo / actions:read).
# Not needed if you use Bitwarden instead:  source load-secrets.sh
GITHUB_TOKEN=your_github_personal_access_token

# Repository whose workflow runs ci_metrics.py analyzes
GITHUB_OWNER=myorg
GITHUB_REPO=myrepo

# Optional: comma-separated workflow file names
# (default: backend-pipeline.yml,frontend-pipeline.yml)
# WORKFLOWS=backend-pipeline.yml

# Optional: also write the JSON metrics to this file
OUTPUT_FILE=./ci-metrics.json
