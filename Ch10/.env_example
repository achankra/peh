# Chapter 10 settings - fallback for readers not using Bitwarden
# Copy this to .env and edit it:  cp .env_example .env
# SECURITY: .env is gitignored. Never commit a real token.
#
# Load into your shell:  set -a && source .env && set +a

# Backstage URL (the port-forward from Chapter 6)
BACKSTAGE_URL=http://localhost:7007

# Optional. Our local Backstage uses guest auth (Ch6), so leave this empty.
# Set it only if your Backstage has real auth enabled.
BACKSTAGE_TOKEN=

# Only needed for the one-time `python3 publish.py --setup-github`.
# GitHub Personal Access Token with repo access:
#   https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=your_github_personal_access_token
