# Chapter 6 secrets - fallback for readers not using Bitwarden
# Copy this to .env and fill in your real token:  cp .env_example .env
# SECURITY: .env is gitignored. Never commit a real token.
#
# Load into your shell:  set -a && source .env && set +a

# GitHub Personal Access Token. Recommended: fine-grained, Contents: Read-only
# on the repos holding your catalog files:
#   https://github.com/settings/personal-access-tokens/new
# Fallback: classic token with 'repo' scope (broader than needed)
GITHUB_TOKEN=your_github_personal_access_token
