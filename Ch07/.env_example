# Chapter 7 configuration - copy this to .env and adjust:  cp .env_example .env
# SECURITY: .env is gitignored. Never commit a real token.
#
# Load into your shell:  set -a && source .env && set +a

ONBOARDING_API_HOST=0.0.0.0
ONBOARDING_API_PORT=5001
# Set to True for development
ONBOARDING_API_DEBUG=False
ONBOARDING_AUDIT_LOG_PATH=./audit.log
ONBOARDING_DB_PATH=./onboarding.db
PERMISSIONS_DB_PATH=./permissions.json
KUBERNETES_NAMESPACE=platform-onboarding
KUBERNETES_CLUSTER=kind-platform-dev

# Keycloak from Chapter 3 (Docker container on port 8180). Optional: when
# KEYCLOAK_ADMIN_CLIENT_SECRET is set, POST /teams also creates the team's
# Keycloak groups (and keycloak_groups.py works). Leave it commented out to skip.
# The secret is in the Admin Console: Clients -> platform-client -> Credentials
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=platform-engineering
KEYCLOAK_ADMIN_CLIENT_ID=platform-client
# KEYCLOAK_ADMIN_CLIENT_SECRET=your_platform_client_secret

# GitHub Personal Access Token for Git operations.
# Not needed if you use Bitwarden instead:  source load-secrets.sh
GITHUB_TOKEN=your_github_personal_access_token
